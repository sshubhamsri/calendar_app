            <TextView android:id="@+id/widget_cell_18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
