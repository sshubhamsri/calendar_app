        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/widget_cell_35" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_36" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_37" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_38" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_39" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_40" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_41" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
