<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: arrows + month name + add + today badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_prev_month"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="&#8249;"
            android:textColor="#CCFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_month_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="MAR"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_month"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:text="&#8250;"
            android:textColor="#CCFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:id="@+id/widget_add_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#CCFFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_today_label"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/today_circle_bg" />
    </LinearLayout>

    <!-- Day-of-week headers with week-number spacer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <!-- Week number spacer -->
        <TextView
            android:layout_width="18dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="8sp" />

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="M" android:textColor="#CCFFFFFF" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="T" android:textColor="#CCFFFFFF" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="W" android:textColor="#CCFFFFFF" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="T" android:textColor="#CCFFFFFF" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F" android:textColor="#CCFFFFFF" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:textColor="#CCFFFFFF" android:textSize="9sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:textColor="#FF6B6B" android:textSize="9sp" android:gravity="center" />
    </LinearLayout>

    <!-- Calendar grid: 6 rows, each row has week number + 7 day cells -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="2dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/widget_week_0" android:layout_width="18dp" android:layout_height="match_parent" android:text="" android:textSize="8sp" android:gravity="center" android:textColor="#80FFFFFF" />
            <TextView android:id="@+id/widget_cell_0"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_1"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_2"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_3"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:gravity="center" android:textColor="#FFFFFF" />
