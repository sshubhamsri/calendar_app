        <View android:layout_width="match_parent" android:layout_height="1px" android:background="#26FFFFFF" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/widget_week_4" android:layout_width="18dp" android:layout_height="match_parent" android:text="" android:textSize="8sp" android:gravity="center" android:textColor="#80FFFFFF" />
            <TextView android:id="@+id/widget_cell_28" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:gravity="center" android:textColor="#FFFFFF" />
