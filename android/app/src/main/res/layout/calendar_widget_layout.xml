            <TextView android:id="@+id/widget_cell_25" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_26" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_27" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/widget_cell_28" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_29" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/widget_cell_30" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
